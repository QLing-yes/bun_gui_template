{
  "name": "my-elysia-app",
  "version": "0.9.9",
  "type": "module",
  "scripts": {
    "menu": "bun --config=./config/bunfig.toml ./system/script/menu.ts",
    "dev": "bun --config=./config/bunfig.toml --parallel run gen:watch watch_dev",
    "start-hot": "NODE_ENV=production bun --config=./config/bunfig.toml --hot ./app/cluster.ts",
    "start-hot-bg": "NODE_ENV=production bun --config=./config/bunfig.toml --hot --background ./app/cluster.ts",
    "fix": "bunx --bun @biomejs/biome check --write --config-path=./config/biome/biome.jsonc .",
    "watch_dev": "bun --config=./config/bunfig.toml --watch ./app/cluster.ts",
    "gen:watch": "bun --config=./config/bunfig.toml ./system/script/index.ts watch",
    "gen": "bun --config=./config/bunfig.toml ./system/script/index.ts",
    "db:generate": "bun --config=./config/bunfig.toml --bun run drizzle-kit generate --config=./config/drizzle/mysql.ts",
    "db:migrate": "bun --config=./config/bunfig.toml --bun run drizzle-kit migrate --config=./config/drizzle/mysql.ts",
    "db:studio": "bun --config=./config/bunfig.toml --bun run drizzle-kit studio --config=./config/drizzle/mysql.ts",
    "db:generate:postgresql": "bun --config=./config/bunfig.toml --bun run drizzle-kit generate --config=./config/drizzle/postgresql.ts",
    "db:migrate:postgresql": "bun --config=./config/bunfig.toml --bun run drizzle-kit migrate --config=./config/drizzle/postgresql.ts",
    "db:studio:postgresql": "bun --config=./config/bunfig.toml --bun run drizzle-kit studio --config=./config/drizzle/postgresql.ts",
    "db:generate:sqlite": "bun --config=./config/bunfig.toml --bun run drizzle-kit generate --config=./config/drizzle/sqlite.ts",
    "db:migrate:sqlite": "bun --config=./config/bunfig.toml --bun run drizzle-kit migrate --config=./config/drizzle/sqlite.ts",
    "db:studio:sqlite": "bun --config=./config/bunfig.toml --bun run drizzle-kit studio --config=./config/drizzle/sqlite.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.84",
    "@elysia/cors": "next",
    "@elysia/openapi": "next",
    "@elysia/static": "next",
    "ai": "^7.0.162",
    "drizzle-orm": "^1.0.0-rc.5",
    "elysia": "next",
    "exact-mirror": "^1.2.6",
    "jose": "^6.2.17",
    "mysql2": "3.22.3",
    "typebox": "^1.3.36"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/bun": "latest",
    "drizzle-kit": "^1.0.0-rc.5",
    "typescript": "~6.0.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
