{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AIGC",
  "version": "0.1.0",
  "identifier": "com.aigc",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:17900",
    "frontendDist": "../src-web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AIGC",
        "width": 1400,
        "height": 850,
        "minWidth": 375,
        "minHeight": 667,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
